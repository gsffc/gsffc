<header class="site-header" role="banner">

  <div class="wrapper">
    <a class="site-title" rel="author" href="{{ "/" | langUrl }}">
      <img style="height: 1.5em; width: auto" src="/favicon.png" />
      {{ meta | ifield: "title" }}
    </a>

    <div class="dropdown">
      <button class="dropbtn">{{ "season_list" | t }} ▾</button>
      <div class="dropdown-content" style="min-width: 120px;">
        {%- for s in navLists -%}
        <a class="page-link" href="{{ "/seasons/" | append: s.key | append: "/" | langUrl }}">{{ s | dname }}</a>
        {%- endfor -%}
      </div>
    </div>

    <div class="dropdown">
      <button class="dropbtn"><img src="/assets/img/lang.svg"> ▾</button>
      <div class="dropdown-content">
        {%- for s in meta.languages -%}
        {%- assign langLabelKey = "global." | append: s -%}
        {%- if s == "zh" -%}
        <a class="page-link" href="{{ page.url }}">{{ langLabelKey | t }}</a>
        {%- else -%}
        <a class="page-link" href="/{{ s }}{{ page.url }}">{{ langLabelKey | t }}</a>
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</header>
