<div class="football_field">
  <img src="/assets/img/field.svg" />

  {% if squad != nil %}
  {% for player in squad %}
    {% if player.locator != nil %}
      <div class="player {{ player.locator }}">
          <img src="/assets/img/{{ player.img | default: 'placeholder-player.jpg' }}" />
          <p>{{ player.number }} {{ player.name }}</p>
      </div>
    {% endif %}
  {% endfor %}
  {% endif %}

</div>
