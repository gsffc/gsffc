---
layout: default
---
<div class="home">
  {%- if title -%}
    <h1 class="page-heading">{{ title }}</h1>
  {%- endif -%}

  {{ content }}

  {%- if collections.posts.size > 0 -%}
    <ul class="post-list">
      {%- for post in collections.posts -%}
      <li>
        <span class="post-meta">
          {{ post.date | date: meta.dateFormat }}
        </span>
        <span class="post-meta">
          • {{ post.data.author }}
        </span>
        {%- include "tags", tags: post.data.postTags -%}
        <h3>
          <a class="post-link" href="{{ post.url | langUrl }}">
            {{ post.data.title | escape }}
          </a>
        </h3>
        {%- if post.data.show_excerpts -%}
          {{ post.data.excerptHtml }}
        {%- endif -%}
      </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

</div>
