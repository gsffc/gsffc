<%- include('partials/header') %>
<% // Weekday labels, Sunday first — Sunday is the grid's leftmost column. %>
<% const weekdays = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']; %>
<% const isAdmin = user && user.role === 'ADMIN'; %>
<div class="page-head">
  <h3>活动日历</h3>
  <% if (isAdmin) { %>
    <button class="btn btn-brand ml-auto" type="button" data-toggle="modal" data-target="#event-modal">
      <i class="fas fa-plus mr-1" aria-hidden="true"></i>添加活动
    </button>
  <% } %>
</div>

<%# Both banners are the same element and the same script — only one of the two
    flags is ever set, since each comes from its own redirect. %>
<% if (created) { %>
  <div class="flash-banner" id="created-banner" role="status">
    <i class="fas fa-check-circle" aria-hidden="true"></i>
    <span>活动已创建，已显示在下面的日历上。</span>
  </div>
<% } else if (deleted) { %>
  <div class="flash-banner is-removed" id="created-banner" role="status">
    <i class="fas fa-trash" aria-hidden="true"></i>
    <span>活动已删除，报名和签到记录已一并清除。</span>
  </div>
<% } %>

<section class="cal card-surface" aria-label="活动日历">
  <header class="cal-bar">
    <div class="cal-title"><%= monthLabel %></div>
    <nav class="cal-nav" aria-label="切换月份">
      <a class="cal-btn" href="/calendar?month=<%= prevMonth %>" aria-label="上个月" rel="nofollow">
        <i class="fas fa-chevron-left" aria-hidden="true"></i>
      </a>
      <a class="cal-btn cal-btn-today<%= isCurrentMonth ? ' is-disabled' : '' %>" href="/calendar">今天</a>
      <a class="cal-btn" href="/calendar?month=<%= nextMonth %>" aria-label="下个月" rel="nofollow">
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
      </a>
    </nav>
  </header>

  <div class="cal-grid" role="grid">
    <div class="cal-weekdays" role="row">
      <% weekdays.forEach((label, i) => { %>
        <div class="cal-weekday<%= (i === 0 || i === 6) ? ' is-weekend' : '' %>" role="columnheader">
          <span class="d-none d-sm-inline"><%= label %></span>
          <span class="d-sm-none"><%= label.slice(-1) %></span>
        </div>
      <% }) %>
    </div>

    <% weeks.forEach(week => { %>
      <div class="cal-week" role="row">
        <% week.forEach(day => { %>
          <div class="cal-day<%= day.inMonth ? '' : ' is-outside' %><%= day.isToday ? ' is-today' : '' %><%= (day.weekday === 0 || day.weekday === 6) ? ' is-weekend' : '' %>" role="gridcell" data-date="<%= day.date %>">
            <div class="cal-date"><%= day.day %></div>
            <% day.events.forEach(e => { %>
              <%# `signupNote` is set by the route and is null once 报名 has
                  opened, so the lock only ever appears on an admin's view of an
                  event the club has not been let at yet. %>
              <a class="cal-event<%= day.isPast ? ' is-past' : '' %><%= e.signupNote ? ' is-restricted' : '' %>" href="/event/<%= e.id %>"
                 title="<%= e.title %> · <%= e.time %> · <%= e.location %><%= e.signupNote ? ' · ' + e.signupNote : '' %>">
                <span class="cal-event-time"><%= (e.time || '').split(' ')[0] %></span>
                <span class="cal-event-title"><% if (e.signupNote) { %><i class="fas fa-lock cal-event-lock" aria-hidden="true"></i><span class="sr-only"><%= e.signupNote %></span><% } %><%= e.title %></span>
              </a>
            <% }) %>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
</section>

<% if (isAdmin) { %>
  <%- include('partials/event-modal', { formEvent: null }) %>
<% } %>

<script>
  (function () {
    // The banner is raised by ?created=1 after the modal reloads the page onto
    // the new event's month, or by ?deleted=1 after an event was deleted from
    // its own page; either way it closes itself 5 seconds later.
    var banner = document.getElementById('created-banner');
    if (!banner) return;
    setTimeout(function () { banner.classList.add('is-leaving'); }, 5000);
    banner.addEventListener('transitionend', function () { banner.remove(); });
  })();
</script>

<%- include('partials/footer') %>
