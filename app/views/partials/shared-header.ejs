    <a class="gsf-brand" href="https://www.gsffc.org/">
      <img class="gsf-brand-logo" src="/favicon.png" alt="GSF" />
      <span class="gsf-brand-name-full">GSF足球俱乐部</span><span class="gsf-brand-name-short">GSF</span>
    </a>
    <nav class="gsf-cross-nav">
      <a href="https://www.gsffc.org/">战报</a>
      <a href="https://app.gsffc.org/" class="active">会员 app</a>
    </nav>
    <%# App-internal nav, rendered inside the shared header shell (generated into
    app/views/partials/shared-header.ejs by `npm run ui:build`). 登出 lives in
    the login corner's hover menu (ui/slots/app-login.ejs), not here. %>
<nav class="gsf-app-nav">
  <a href="/calendar"<% if (path === '/calendar') { %> class="active"<% } %>>活动日历</a>
  <a href="/members"<% if (path === '/members') { %> class="active"<% } %>>会员列表</a>
</nav>
    <%# App's login corner: rendered server-side — the session is already known
    here, no probe script needed (that's www's, ui/slots/www-login.html).
    登出 sits in the hover menu under the member's name. %>
<div class="gsf-login-corner gsf-dropdown">
  <% if (user) { %>
  <a href="/profile" title="个人资料"><%= user.name %> ▾</a>
  <div class="gsf-dropdown-content">
    <a href="/logout">登出</a>
  </div>
  <% } else { %>
  <a class="gsf-login-link<%= path === '/login' ? ' active' : '' %>" href="/login">登录</a>
  <% } %>
</div>
  </div>
</header>
