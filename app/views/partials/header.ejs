<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#4DA5F4">
  <title><%= title %> - GSF App</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css">
  <!-- Loaded here, and only here: the check-in map and the admin event form's
       picker can both be on one page, and a second copy of leaflet.js would
       swap `L` out from under whichever map was built first. Not deferred —
       the inline map scripts run during parsing and need `L` already defined. -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/ui/ui.css">
  <link rel="stylesheet" href="/css/soccer/custom-football-squad.css">
  <link rel="stylesheet" href="/css/calendar.css">
  <link rel="stylesheet" href="/css/members.css">
  <link rel="stylesheet" href="/css/event.css">
</head>
<% // The calendar is a full-viewport page: the grid fills the space under the
   // shared header and nothing scrolls. Both hooks live in calendar.css. %>
<% const fullBleed = path === '/calendar'; %>
<body class="<%= fullBleed ? 'page-full' : '' %>">
<%- include('shared-header') %>
</div>
<div class="<%= fullBleed ? 'container-fluid' : 'container' %> main-content">
